# Copy to .env and fill in. Every value here is a field on app.config.Settings, except the
# compose-only variables in the last block, which only the compose files read.
# The .env file is read from the repository root whatever the process's working directory is
# (backend/app/config.py anchors it there), so running from backend/ works. docker compose reads
# the same file twice: for ${VAR:-default} interpolation in the compose files and as the env_file
# of migrate, api and worker. The no-keys synthetic stack (`docker compose up --build -d` from a
# fresh checkout) needs no .env at all.

# --- Providers -------------------------------------------------------------------------------------
# Live defaults. LLM_PROVIDER is anthropic | fake; EMBEDDING_PROVIDER is openai | voyage | fake.
# The three lines below must agree and are changed together: SYNTHETIC_DEMO=true requires both
# providers to be fake, and a live provider requires its key. An empty key means "not set". The
# API and the worker check this at start-up and refuse to run with a plain message otherwise.
LLM_PROVIDER=anthropic
EMBEDDING_PROVIDER=openai
SYNTHETIC_DEMO=false
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
VOYAGE_API_KEY=

# Synthetic stack: the deterministic heuristic providers, no keys, and both upload routes
# (POST /documents and POST /tenders/{id}/documents) restricted by checksum to the files in
# eval/data. A plumbing demonstration, not evidence of model quality. To select it, replace the
# three live lines above with these three; `docker compose up` without a .env uses exactly these.
# LLM_PROVIDER=fake
# EMBEDDING_PROVIDER=fake
# SYNTHETIC_DEMO=true

# Models
MODEL_MAIN=claude-opus-5
MODEL_FAST=claude-sonnet-5
EMBEDDING_MODEL_OPENAI=text-embedding-3-small
EMBEDDING_MODEL_VOYAGE=voyage-3
# Dimension of the vector columns. Changing it is a migration and a re-embed of the library.
EMBEDDING_DIMENSION=1536

# --- Infrastructure --------------------------------------------------------------------------------
# Native backend database (backend/scripts/dev_db.py). The compose stack pins its own private
# database without a published port and ignores this value.
DATABASE_URL=postgresql+psycopg://postgres@127.0.0.1:54329/tenders_dev

# Service secret for the API (32+ characters): every request must then carry
# Authorization: Bearer <secret>. Leave it unset for a native run against dev_db.py. The compose
# stack always sets one from BACKEND_SERVICE_SECRET (see the compose-only block).
# SERVICE_SECRET=<shared-random-service-secret>

# Where uploaded files are kept for download. Everything downstream reads document_sections, not
# files. Default: <repo>/storage. Any override should be an absolute path; a relative one is
# resolved against the process's working directory, not the repository.
# STORAGE_PATH=/absolute/path/to/storage

# Largest file either upload route (POST /documents, POST /tenders/{id}/documents) accepts, in
# bytes. Default 25 MiB. A larger file is refused with 413 before anything is stored, and a
# request body over the limit (plus a small multipart allowance) is refused before it is read.
# The compose stack passes the same value to the web proxy, which refuses a larger file with 413
# before it reaches the API, so the two limits never drift; the frontend's own default is also
# 25 MiB, and both layers use the same 413 sentence.
MAX_UPLOAD_BYTES=26214400

# Docling PDF layout and TableFormer weights, downloaded at image build time (see backend/Dockerfile).
DOCLING_ARTIFACTS_PATH=/opt/docling-models

# Seeded organisation used when the X-Org-Id header is absent.
DEFAULT_ORG_ID=00000000-0000-4000-8000-000000000001

# Browser origins allowed to call the API, comma-separated (the Next.js front end). Never "*":
# list the front end's origin for each environment, e.g. http://localhost:3000,https://bids.example
CORS_ORIGINS=http://localhost:3000

# Pre-parsed fixture document inserted by the seed. Default:
# <repo>/eval/data/fixtures/fixture_document.json. Any override should be an absolute path.
# FIXTURE_DOCUMENT_PATH=/absolute/path/to/fixture_document.json

# --- Thresholds (read by the pipeline and the evaluation harness) ----------------------------------
DEDUP_THRESHOLD=0.90
VERBATIM_THRESHOLD=0.92
COVERAGE_FLOOR=0.45
REALIGN_MIN=0.85
SPAN_MATCH_MIN=0.90
EXTRACTION_FIDELITY_TARGET=0.90
PAIR_EXTRACTION_WINDOW_TOKENS=6000
MAX_ATTEMPTS=3
CHUNK_TARGET_TOKENS=400
RRF_K=60
CANDIDATES_PER_LIST=20
TOP_K_SYNTHESIS=8
COVERAGE_JUDGEMENT_TOP=3
TRIAGE_CONCURRENCY=15
DRAFT_ALL_CONCURRENCY=4

# Worker
WORKER_POLL_INTERVAL_SECONDS=1.0
EXPIRY_SWEEP_INTERVAL_SECONDS=3600

# Logging
LOG_LEVEL=INFO

# --- Compose-only variables (read by docker-compose.yml, ignored by Settings) ----------------------
# The frontend's public origin; also Supabase Auth's site URL and redirect allow-list.
APP_URL=http://localhost:3000
# Shared service secret for the joined stack: compose passes it to the frontend as
# BACKEND_SERVICE_SECRET and to migrate, api and worker as SERVICE_SECRET. One random value of at
# least 32 characters; the compose default is for local synthetic development only and must never
# be used when hosted.
# BACKEND_SERVICE_SECRET=<shared-random-service-secret>
# Account-menu switch between the development accounts; APP_MODE=development stacks only.
# DEMO_USER_SWITCH=true
