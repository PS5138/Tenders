{
  "name": "ten",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "typecheck": "tsc --noEmit",
    "local:start": "scripts/local/start.sh",
    "local:stop": "scripts/local/stop.sh",
    "db:reset": "scripts/local/reset-db.sh",
    "db:migrate": "node --env-file-if-exists=.env.local --conditions=react-server --import tsx scripts/migrate.ts",
    "db:provision": "node --env-file-if-exists=.env.local --conditions=react-server --import tsx scripts/seed-provision.ts",
    "db:seed":"node --env-file-if-exists=.env.local --conditions=react-server --import tsx scripts/seed-backend.ts",
    "business:create": "node --env-file-if-exists=.env.local --conditions=react-server --import tsx scripts/create-business.ts",
    "user:reset-link": "node --env-file-if-exists=.env.local --conditions=react-server --import tsx scripts/reset-link.ts",
    "test": "vitest run",
    "test:db": "vitest run --config vitest.backend.config.mts",
    "test:integration": "vitest run --config vitest.backend.config.mts",
    "test:watch": "vitest",
    "test:e2e": "playwright test",
    "backend:types": "node --env-file-if-exists=.env.local scripts/generate-backend-types.mjs",
    "business:link-backend": "node --env-file-if-exists=.env.local --conditions=react-server --import tsx scripts/link-backend-org.ts",
    "db:seed-backend": "node --env-file-if-exists=.env.local --conditions=react-server --import tsx scripts/seed-backend.ts",
    "business:provision-backend": "node --env-file-if-exists=.env.local --conditions=react-server --import tsx scripts/provision-backend.ts",
    "test:ui": "node tests/ui/smoke.mjs"
  },
  "dependencies": {
    "@radix-ui/react-dialog": "1.1.23",
    "@radix-ui/react-dropdown-menu": "2.1.24",
    "@radix-ui/react-popover": "1.1.23",
    "@supabase/ssr": "0.12.7",
    "@supabase/supabase-js": "2.117.2",
    "fast-xml-parser": "5.11.1",
    "fflate": "0.8.3",
    "lucide-react": "1.48.0",
    "next": "16.3.6",
    "postgres": "3.4.9",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "server-only": "^0.0.1",
    "tsx": "4.23.15",
    "zod": "4.6.5"
  },
  "devDependencies": {
    "@playwright/test": "1.63.0",
    "@tailwindcss/postcss": "^4",
    "@types/node": "^22.20.4",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "16.3.6",
    "openapi-typescript": "7.13.0",
    "tailwindcss": "^4",
    "typescript": "^5",
    "vitest": "5.0.2"
  },
  "packageManager": "pnpm@10.33.0"
}
