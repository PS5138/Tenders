# Server-only configuration. Copy to .env.local for native development.
APP_MODE=development
APP_URL=http://localhost:3000
SUPABASE_URL=http://127.0.0.1:54321
SUPABASE_ANON_KEY=<anon-key>
SUPABASE_SERVICE_ROLE_KEY=<service-role-key>
DATABASE_URL=postgres://postgres:<password>@127.0.0.1:54322/ten_frontend
DATABASE_POOL_MAX=10
DATABASE_PREPARE=false
BACKEND_URL=http://127.0.0.1:8000
# Must match backend SERVICE_SECRET; required (32+ characters) in APP_MODE=demo.
BACKEND_SERVICE_SECRET=<shared-random-service-secret>
